---
import Figure from "./Figure.astro";
import { listPublications } from "../data/publications.ts";
import { Theses } from "../data/theses.ts";
import { listTalks } from "../data/talks.ts";

const published = listPublications.filter((a) => a.status === "published");
const preprints = listPublications.filter((a) => a.status === "preprint");

const shownTalks = listTalks.filter((t) => t.show !== false);
const groupedTalks = Object.groupBy(shownTalks, (t) => t.title);
const talkGroups = Object.entries(groupedTalks)
  .map(([title, talks]) => ({ title, talks: talks! }))
  .sort((a, b) => {
    const latest = (talks: typeof a.talks) =>
      Math.max(...talks.map((t) => new Date(t.date).getTime()));
    return latest(b.talks) - latest(a.talks);
  });

const yearOf = (date: string) => new Date(date).getFullYear();
const yearRange = (talks: typeof shownTalks) => {
  const years = talks.map((t) => yearOf(t.date));
  const lo = Math.min(...years);
  const hi = Math.max(...years);
  return lo === hi ? String(lo) : `${lo}–${hi}`;
};
---

{
  [
    {
      id: "published",
      eyebrow: `${published.length} peer-reviewed`,
      heading: "Published",
      pubs: published,
    },
    {
      id: "preprints",
      eyebrow: `${preprints.length} under review`,
      heading: "Preprints",
      pubs: preprints,
    },
  ]
    .filter((group) => group.pubs.length > 0)
    .map((group) => (
      <section class="band" id={group.id}>
        <p class="eyebrow">{group.eyebrow}</p>
        <h2>{group.heading}</h2>
        <ul class="item-list">
          {group.pubs.map((pub) => (
            <li>
              {pub.image && (
                <Figure src={pub.image} alt={`Figure from "${pub.title}"`} href={pub.link} />
              )}
              <div class="prose">
                <a href={pub.link} target="_blank" rel="noopener">
                  {pub.title}
                </a>
                <p class="meta">
                  <span class="date">{pub.date}</span> · {pub.journal}
                  {pub.additional && <> · {pub.additional}</>}
                  {pub.code && (
                    <>
                      {" · "}
                      <a href={pub.code} target="_blank" rel="noopener">
                        [Code]
                      </a>
                    </>
                  )}
                </p>
                <p class="meta">
                  {pub.authors.map((author, i) => (
                    <>
                      {i > 0 && ", "}
                      {author === "HF" ? <strong>Hidde Fokkema</strong> : author}
                    </>
                  ))}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
}

<section class="band" id="thesis">
  <p class="eyebrow">Defended January 2026</p>
  <h2>PhD Thesis</h2>
  <ul class="item-list">
    <li>
      <Figure
        class="figure--cover"
        src="/paper_diagrams/PhD_cover.png"
        alt="Cover of the PhD thesis"
        href="https://pure.uva.nl/ws/files/277470997/Thesis.pdf"
      />
      <div class="prose">
        <a
          href="https://dare.uva.nl/search?identifier=e0b2c89d-603a-4edc-b9b9-59a6547c1eec"
          target="_blank"
          rel="noopener"
        >
          Mathematical Foundations of Explainable AI and Advances in Bandit Optimisation
        </a>
        <p class="meta">
          University of Amsterdam ·
          <a
            href="https://pure.uva.nl/ws/files/277470997/Thesis.pdf"
            target="_blank"
            rel="noopener"
          >
            [PDF]
          </a>
        </p>
        <p>
          This thesis shows that two properties people want from explainability methods work against
          each other: attribution-based explanations that provide recourse cannot always be robust,
          and acting on recourse can lower a model's accuracy. It also develops methods that combine
          causal representation learning with concept learning, and improves the best known regret
          bounds for bandit convex optimisation in both the stochastic and adversarial case.
          Throughout, the aim is to be explicit about where these methods can be trusted, and where
          they can't.
        </p>
      </div>
    </li>
  </ul>
</section>

<section class="band" id="talks">
  <p class="eyebrow">{shownTalks.length} talks, {talkGroups.length} topics</p>
  <h2>Talks</h2>
  <ul class="item-list">
    {
      talkGroups.map((group) => (
        <li>
          <p class="meta date hang">{yearRange(group.talks)}</p>
          <div class="prose">
            <h3>{group.title}</h3>
            <ul class="sub-list">
              {group.talks.map((talk) => (
                <li>
                  <p class="meta">
                    {talk.location}, {talk.date}
                    {talk.links?.map((link) => (
                      <>
                        {" · "}
                        <a href={link.href} target="_blank" rel="noopener">
                          [{link.label}]
                        </a>
                      </>
                    ))}
                  </p>
                  {talk.note && <p class="meta">{talk.note}</p>}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<section class="band" id="earlier">
  <p class="eyebrow">Before the PhD</p>
  <h2>Master's and Bachelor's theses</h2>
  <ul class="item-list">
    {
      Theses.map((thesis) => (
        <li>
          <p class="meta date hang">{thesis.date}</p>
          <div class="prose">
            <a href={`/files/${thesis.link}`} target="_blank" rel="noopener">
              {thesis.title}
            </a>
            <p class="meta">
              {thesis.type} · supervised by {thesis.supervisors}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
