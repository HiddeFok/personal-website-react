---
import Figure from "./Figure.astro";
import phdCover from "../assets/paper_diagrams/PhD_cover.png";
import { listPublications } from "../data/publications.ts";
import { Theses } from "../data/theses.ts";
import { listTalks } from "../data/talks.ts";

const published = listPublications.filter((a) => a.status === "published");
const preprints = listPublications.filter((a) => a.status === "preprint");

const shownTalks = listTalks.filter((t) => t.show !== false);
const groupedTalks = Object.groupBy(shownTalks, (t) => t.title);
const talkGroups = Object.entries(groupedTalks)
  .map(([title, talks]) => ({ title, talks: talks! }))
  .sort((a, b) => {
    const latest = (talks: typeof a.talks) =>
      Math.max(...talks.map((t) => new Date(t.date).getTime()));
    return latest(b.talks) - latest(a.talks);
  });

const yearOf = (date: string) => new Date(date).getFullYear();
const yearRange = (talks: typeof shownTalks) => {
  const years = talks.map((t) => yearOf(t.date));
  const lo = Math.min(...years);
  const hi = Math.max(...years);
  return lo === hi ? String(lo) : `${lo}–${hi}`;
};
---

{
  [
    {
      id: "published",
      heading: "Published",
      pubs: published,
    },
    {
      id: "preprints",
      heading: "Preprints",
      pubs: preprints,
    },
  ]
    .filter((group) => group.pubs.length > 0)
    .map((group) => (
      <section class="band" id={group.id}>
        <h2>{group.heading}</h2>
        <ul class="item-list">
          {group.pubs.map((pub) => (
            <li>
              {pub.image && (
                <Figure src={pub.image} alt={`Figure from "${pub.title}"`} href={pub.link} />
              )}
              <div class="prose">
                <a href={pub.link} target="_blank" rel="noopener">
                  {pub.title}
                </a>
                <p class="meta">
                  <span class="date">{pub.date}</span> · {pub.journal}
                  {pub.additional && <> · {pub.additional}</>}
                  {pub.code && (
                    <>
                      {" · "}
                      <a href={pub.code} target="_blank" rel="noopener">
                        [Code]
                      </a>
                    </>
                  )}
                </p>
                <p class="meta">
                  {pub.authors.map((author, i) => (
                    <>
                      {i > 0 && ", "}
                      {author === "HF" ? <strong>Hidde Fokkema</strong> : author}
                    </>
                  ))}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
}

<section class="band" id="thesis">
  <p class="eyebrow">Defended January 2026</p>
  <h2>PhD Thesis</h2>
  <ul class="item-list">
    <li>
      <Figure
        class="figure--cover"
        src={phdCover}
        alt="Cover of the PhD thesis"
        href="https://pure.uva.nl/ws/files/277470997/Thesis.pdf"
      />
      <div class="prose">
        <a
          href="https://dare.uva.nl/search?identifier=e0b2c89d-603a-4edc-b9b9-59a6547c1eec"
          target="_blank"
          rel="noopener"
        >
          Mathematical Foundations of Explainable AI and Advances in Bandit Optimisation
        </a>
        <p class="meta">
          University of Amsterdam ·
          <a
            href="https://pure.uva.nl/ws/files/277470997/Thesis.pdf"
            target="_blank"
            rel="noopener"
          >
            [PDF]
          </a>
        </p>
        <p class="summary">
          My dissertation consists of two parts. In the first part it presents several works that
          expand the mathematical foundations explainable AI methods. In particular, it investigates
          attribution methods, counterfactual methods and concept-based models. Attribution methods
          indicate which input features are the most important to a particular model. What
          importance means is often ambiguous. We propose one interpretation in Chapter 2, where we
          interpret the attribution scores as a direction. The direction tells the user how to
          change their features to achieve a certain goal. We show that such methods are not robust
          with respect to the input: users with very similar attributes, might get drastically
          different explanations. In the following chapters 3 and 4, we zoom in on the
          counterfactual explanations. We demonstrate that following these explanations will change
          the underlying data distribution. We show that this can result in a decrease in accuracy
          of the model and even invalid the explanations themselves over time. In Chapter 5 we
          propose a method and new framework that can be used to develop sample-efficient
          concept-based models. By effectively leveraging the techniques used in Causal
          Representation Learning, we are able to be more data efficient. Finally, in the second
          part and the last chapter, we look at the bandit convex optimisation problem. We propose a
          new algorithm that is able to solve this problem, which has improved regret bounds
          compared to earlier algorithms, while being efficiently implementable.
        </p>
      </div>
    </li>
  </ul>
</section>

<section class="band" id="talks">
  <h2>Talks</h2>
  <ul class="item-list">
    {
      talkGroups.map((group) => (
        <li>
          <p class="meta date hang">{yearRange(group.talks)}</p>
          <div class="prose">
            <h3>{group.title}</h3>
            <ul class="sub-list">
              {group.talks.map((talk) => (
                <li>
                  <p class="meta">
                    {talk.location}, {talk.date}
                    {talk.links?.map((link) => (
                      <>
                        {" · "}
                        <a href={link.href} target="_blank" rel="noopener">
                          [{link.label}]
                        </a>
                      </>
                    ))}
                  </p>
                  {talk.note && <p class="meta">{talk.note}</p>}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<section class="band" id="earlier">
  <p class="eyebrow">Before the PhD</p>
  <h2>Master's and Bachelor's theses</h2>
  <ul class="item-list">
    {
      Theses.map((thesis) => (
        <li>
          <p class="meta date hang">{thesis.date}</p>
          <div class="prose">
            <a href={`/files/${thesis.link}`} target="_blank" rel="noopener">
              {thesis.title}
            </a>
            <p class="meta">
              {thesis.type} · supervised by {thesis.supervisors}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
