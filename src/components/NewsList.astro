---
import { newsItems } from "../data/news.ts";

const newsSorted = newsItems.sort((a, b) => {
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});
---

<ul class="item-list news">
  {
    newsSorted?.map((news) => (
      <li>
        <p class="meta date hang">{news.date}</p>
        <p>
          {news.text}
          {news.links?.map((link) => (
            <>
              {" "}
              <a class="meta" href={link.href} target="_blank" rel="noopener">[{link.label}]</a>
            </>
          ))}
        </p>
      </li>
    ))
  }
</ul>
