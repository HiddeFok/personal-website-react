---
import Figure from "./Figure.astro";

interface Interest {
  subject: string;
  text: string;
  image: string;
  href: string;
}

const interests: Interest[] = [
  {
    subject: "Mathematical Foundations of Explainable AI",
    text: "We showed that attribution-based explanations that provide recourse cannot be robust, and that offering recourse can hurt the accuracy of a deployed classifier. We also introduced a framework combining causal representation learning and concept learning to build concept-based models with formal guarantees on the concepts they learn.",
    image: "/paper_diagrams/concept_learning.png",
    href: "/research#published",
  },
  {
    subject: "Bandit Optimisation",
    text: "I worked on improving the best known regret bounds for bandit convex optimisation, in both the stochastic and adversarial case.",
    image: "/gifs/Online_Newton_Step.mp4",
    href: "/research#published",
  },
];
---

<section class="band">
  <slot />
  <div class="prose">
    <h1>Machine learning theory, applied under real constraints.</h1>
    <p>
      I am a researcher in Machine Learning, currently working as an AI Research Engineer at <a
        href="https://www.plumerai.com"
        target="_blank"
        rel="noopener">Plumerai</a
      >, where I work on efficient deep learning for embedded hardware &mdash; taking the same
      optimisation and learning-theory questions from my PhD and applying them under real deployment
      constraints.
    </p>
    <p>
      Between finishing my PhD and joining Plumerai, I spent three months at Booking.com as a
      Machine Learning Scientist, putting some of the bandit optimisation theory from my PhD into
      production.
    </p>
    <p>
      I completed my PhD at the <a href="https://kdvi.uva.nl/" target="_blank" rel="noopener"
        >Korteweg-de Vries Institute</a
      > of the University of Amsterdam, supervised by <a
        href="http://www.timvanerven.nl/"
        target="_blank"
        rel="noopener">dr. Tim van Erven</a
      >. My research there focussed on the two themes below.
    </p>
  </div>
</section>
<section class="band">
  <p class="eyebrow">Two themes</p>
  <h2>Research interests</h2>
  <ul class="item-list">
    {
      interests.map((interest) => (
        <li>
          <Figure src={interest.image} alt={interest.subject} href={interest.href} />
          <div class="prose">
            <strong>{interest.subject}</strong>
            <p>{interest.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
  <div class="prose">
    <p>
      The papers behind both themes are on the <a href="/research">Research page</a>; the code,
      including a PyTorch implementation of one of the bandit algorithms, is on the <a
        href="/projects">Projects page</a
      >. I'm also interested in the intersection of AI and the physical sciences, and in optimal
      transport and stochastic calculus more broadly, from my Master's research.
    </p>
    <p>
      <a
        class="btn btn--primary"
        href="/files/CV_Hidde_Fokkema_public.pdf"
        target="_blank"
        rel="noopener"
      >
        Curriculum Vit&aelig;
      </a>
    </p>
  </div>
</section>
